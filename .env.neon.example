# Neon Database Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# NEON DATABASE CONFIGURATION
# ===========================================

# Neon Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech/
# Format: postgresql://[user]:[password]@[endpoint]/[database]?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Alternative: Individual Neon connection parameters
# (Use either NEON_DATABASE_URL or the individual parameters below)
NEON_HOST=ep-example-123456.us-east-1.aws.neon.tech
NEON_DATABASE=neondb
NEON_USERNAME=username
NEON_PASSWORD=password
NEON_PORT=5432

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================

# Since Neon doesn't provide file storage, you'll need an alternative
# Option 1: Cloudinary (Recommended)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Option 2: AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Option 3: Uploadcare
# UPLOADCARE_PUBLIC_KEY=your_public_key
# UPLOADCARE_SECRET_KEY=your_secret_key

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Application Settings
APP_ENV=development
APP_URL=http://localhost:8888

# CORS Settings (for local development)
CORS_ORIGIN=http://localhost:3000,http://localhost:8888

# ===========================================
# LEGACY SUPABASE CONFIGURATION (FOR MIGRATION)
# ===========================================
# Keep these during migration process for data transfer
# Remove after successful migration

# Supabase Configuration (for migration only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_KEY=your_supabase_service_role_key

# ===========================================
# NETLIFY CONFIGURATION
# ===========================================

# For Netlify Functions
NETLIFY_DEV=true

# ===========================================
# MIGRATION NOTES
# ===========================================

# 1. REQUIRED CHANGES:
#    - Replace SUPABASE_URL with NEON_DATABASE_URL
#    - Set up file storage service (Cloudinary recommended)
#    - Update all Netlify functions to use Neon SQL client
#    - Update frontend API calls if needed

# 2. MIGRATION STEPS:
#    a) Set up Neon database and get connection string
#    b) Set up file storage service (Cloudinary/AWS S3)
#    c) Run schema migration to create tables in Neon
#    d) Update environment variables
#    e) Update Netlify functions
#    f) Run data migration script
#    g) Test all functionality
#    h) Remove Supabase configuration

# 3. PACKAGE DEPENDENCIES TO ADD:
#    - @neondatabase/serverless (for Neon connection)
#    - cloudinary (if using Cloudinary for file storage)
#    - Remove: @supabase/supabase-js

# 4. NETLIFY FUNCTIONS CHANGES:
#    - Replace createClient() with neon() connection
#    - Update file upload logic to use new storage service
#    - Update database queries to use SQL syntax instead of Supabase methods
#    - Handle connection pooling and error handling

# 5. FRONTEND CHANGES:
#    - Update API endpoints if changed
#    - Update file upload handling
#    - Update error handling for new response formats

# ===========================================
# SECURITY NOTES
# ===========================================

# - Never commit actual credentials to version control
# - Use strong passwords for database connections
# - Enable SSL/TLS for all database connections
# - Regularly rotate API keys and passwords
# - Use environment-specific configurations
# - Enable proper CORS settings for production